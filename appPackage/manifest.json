{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "developer": {
    "name": "Hive Team",
    "websiteUrl": "https://github.com/YOUR-USERNAME/hive",
    "privacyUrl": "https://github.com/YOUR-USERNAME/hive/blob/main/PRIVACY.md",
    "termsOfUseUrl": "https://github.com/YOUR-USERNAME/hive/blob/main/TERMS.md"
  },
  "name": {
    "short": "Hive",
    "full": "Hive - Privilege Escalation Watchdog"
  },
  "description": {
    "short": "Privilege-escalation watchdog for Microsoft 365 Copilot.",
    "full": "Hive is a multi-agent privilege-escalation watchdog for Microsoft 365 Copilot. It correlates risky role changes, Kerberos/OAuth token misuse, and lateral movement across hybrid identity into prioritized incidents, and recommends containment - complementing Microsoft 365 security by catching escalation precursors before full compromise."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#0B3D2E",
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "hive",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "permissions": [
    "identity"
  ],
  "validDomains": [
    "YOUR-FUNCTION-APP.azurewebsites.net"
  ]
}
